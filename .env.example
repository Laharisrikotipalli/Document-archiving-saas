# --- Database ---
POSTGRES_USER=archive
POSTGRES_PASSWORD=archive
POSTGRES_DB=archive
DATABASE_URL=postgres://archive:archive@db:5432/archive

# --- API ---
API_PORT=3000
PRESIGNED_URL_EXPIRY_SECONDS=900

# --- Cloud / Object Storage ---
# For local dev these point at the MinIO service defined in docker-compose.yml.
# For production, point these at a real S3 / GCS bucket instead.
CLOUD_STORAGE_BUCKET_NAME=archive-documents
CLOUD_STORAGE_REGION=us-east-1
CLOUD_STORAGE_ACCESS_KEY_ID=minioadmin
CLOUD_STORAGE_SECRET_ACCESS_KEY=minioadmin
CLOUD_STORAGE_ENDPOINT_URL=http://storage:9000
CLOUD_STORAGE_FORCE_PATH_STYLE=true

# Do NOT commit a real .env file with real secrets. This file is a template only.
